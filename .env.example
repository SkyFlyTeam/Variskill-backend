# Django
DJANGO_SETTINGS_MODULE=settings.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Build (docker-compose-build.yaml): hosts aceitos em produção. "*" aceita qualquer IP/domínio.
DJANGO_BUILD_ALLOWED_HOSTS=*
# Em produção use DJANGO_DEBUG=False e defina DJANGO_SECRET_KEY (obrigatória nesse modo).
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=

# Segurança (ative em produção com TLS terminado no proxy/nginx)
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_PROTO=False

# LGPD (defaults seguros; desligue apenas para compatibilidade com clientes legados)
LGPD_RESTRINGIR_USERS=True
LGPD_CAMPOS_READONLY=True
LGPD_LIMPAR_AO_REVOGAR=False
LGPD_RETENCAO_DIAS=365
LGPD_MAX_PROMPT_CHARS=500

# PostgreSQL + pgvector
POSTGRES_DB=cookie_cutter
POSTGRES_USER=cookie_cutter
POSTGRES_PASSWORD=cookie_cutter
POSTGRES_HOST=database
POSTGRES_PORT=5432

# NLP
# Similaridade mínima para aceitar uma intenção
NLP_SIMILARITY_THRESHOLD=0.70

# External AI / LLM (Suporte Contextual - VAR-65)
OPENAI_API_KEY=""
EXTERNAL_AI_API_KEY=""
EXTERNAL_AI_MODEL="gpt-4o-mini"
# Timeout (segundos) da chamada à IA externa
EXTERNAL_AI_TIMEOUT_SECONDS=3
# Circuit breaker da IA externa: nº de falhas seguidas para abrir o circuito
EXTERNAL_AI_CIRCUIT_FAILURE_THRESHOLD=3
# Tempo (segundos) que o circuito fica aberto até testar a IA de novo
EXTERNAL_AI_CIRCUIT_RECOVERY_TIMEOUT=30
